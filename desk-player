    def page_liked(self):
        self.back_header("Brani che ti piacciono")
        self.toolbar()
        if self.liked_state is None:
            self.liked_state = {"items": [], "total": None, "loading": False}
        st = self.liked_state
        holder = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, vexpand=True)
        self.content.pack_start(holder, True, True, 0)
        token = self.token

        def build_list(scroll_to=None):
            for ch in holder.get_children():
                holder.remove(ch); ch.destroy()
            self.track_labels = []
            tracks = self.sorted_items(st["items"])
            view = self.scrolled_list(holder)
            if not tracks:
                self.empty(view, "Niente qui")
            self.add_tracks(view, tracks, lambda i: self.play_track(tracks[i], liked=True))
            more = st["total"] is not None and len(st["items"]) < st["total"]
            if more:
                view.empty(f"{len(st['items'])} di {st['total']} · scorri per caricarne altri")
            view.sw.connect("edge-reached", lambda _sw, pos: pos == Gtk.PositionType.BOTTOM and load_more(view))
            self._liked_more = lambda: load_more(view)  # per i test (dpnav.sh liked-more)
            holder.show_all()
            if scroll_to is not None:
                adj = view.sw.get_vadjustment()
                GLib.timeout_add(60, lambda: adj.set_value(scroll_to) and False)

        def load_more(view):
            if st["loading"] or st["total"] is None or len(st["items"]) >= st["total"]:
                return
            st["loading"] = True
            pos = view.sw.get_vadjustment().get_value()

            def done(res):
                st["loading"] = False
                st["items"] += res[0]; st["total"] = res[1]
                self.saved.update((t["uri"], True) for t in res[0])
                print(f"preferiti caricati: {len(st['items'])} di {st['total']}", flush=True)
                if token == self.token:
                    build_list(scroll_to=pos)
                return False

            def fail(e):
                st["loading"] = False
                return self.on_error(e)
            self.bg(lambda: self.api.liked_page(len(st["items"]), 50), done, fail)

        if st["items"]:
            build_list()
            return

        def first():
            a, total = self.api.liked_page(0, 50)
            b, total = self.api.liked_page(50, 50) if total > 50 else ([], total)
            if self.sort_mode == "recent":
                try:
                    self.api.recent_map()
                except Exception:
                    pass
            return a + b, total

        def built(_container, res):
            st["items"], st["total"] = res
            self.saved.update((t["uri"], True) for t in res[0])
            build_list()
        self.load(holder, None, first, built)

    def page_detail(self, c):
        sub = self.back_header(c["name"], c["subtitle"], c["image"] or "", play=lambda: self.play_context(c["uri"]))
        if c["kind"] == "artist":
            self.artist_page(c)
            return
        if c["kind"] == "playlist":
            self.toolbar()
        if c["kind"] == "playlist":
            fn = lambda: self.api.playlist_tracks(c["id"])  # noqa: E731
        else:
            fn = lambda: self.api.album_tracks(c)  # noqa: E731

        def build(container, data):
            tracks = data["tracks"]
            if c["kind"] == "playlist":
                sub.set_text(detail_info(c["subtitle"], data["date"], tracks, created=True))
            else:
                sub.set_text(detail_info(" · ".join(x for x in (data.get("artists"), data.get("type")) if x),
                                         data["date"], tracks))
            if c["kind"] == "playlist":
                tracks = self.sorted_items(tracks)
            lb = self.scrolled_list(container, force_list=True)
            if not tracks:
                self.empty(lb, "Nessun brano")
            self.add_tracks(lb, tracks, lambda i: self.play_context(c["uri"], tracks[i]["uri"]),
                            thumbs=c["kind"] == "playlist")
        fn = self.with_saved(fn, lambda d: d["tracks"])
        self.load(self.content, "detail:" + c["id"], self.with_recent(fn) if c["kind"] == "playlist" else fn, build)

    def artist_page(self, c):
        chips = Gtk.Box(spacing=8)
        chips.set_margin_start(14); chips.set_margin_bottom(4)
        for key, text in (("all", "Tutto"), ("album", "Album"), ("single", "Singoli"), ("ep", "EP")):
            b = Gtk.Button(label=text); b.get_style_context().add_class("chip")
            if key == self.artist_filter:
                b.get_style_context().add_class("sel")
            b.connect("clicked", lambda _b, k=key: (setattr(self, "artist_filter", k), self.render()))
            chips.pack_start(b, False, False, 0)
        self.page_sorts = self.PAGE_SORTS["releases"]
        chips.pack_end(self.sort_button(), False, False, 8)
        self.content.pack_start(chips, False, False, 0)
        header_image = self.header_image

        def build(container, data):
            if data.get("image") and header_image is not None and not c["image"]:
                set_image(header_image, data["image"], 48)
            types = {"all": None, "album": ("Album", "Raccolta"), "single": ("Singolo",), "ep": ("EP",)}[self.artist_filter]
            shown = [r for r in data["releases"] if types is None or r["type"] in types]
            lb = self.scrolled_list(container)
            if not shown:
                self.empty(lb, "Niente qui")
            self.add_colls(lb, self.sorted_items(shown))
        self.load(self.content, "artist:" + c["id"], self.with_recent(lambda: self.api.artist(c["id"])), build)


class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="it.dario.deskplayer", flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.win = None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        Gtk.Settings.get_default().set_property("gtk-application-prefer-dark-theme", True)
        Gtk.IconTheme.get_default().append_search_path(os.path.join(APP_DIR, "icons"))  # icone dell'app
        prov = Gtk.CssProvider(); prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        # azione D-Bus per aprire una sezione: library, search, queue, devices, liked, recent
        upd = Gio.SimpleAction.new("check-updates", None)   # per i test, via D-Bus
        upd.connect("activate", lambda *_: self.win and self.win.check_updates())
        self.add_action(upd)
        nav = Gio.SimpleAction.new("navigate", GLib.VariantType.new("s"))
        nav.connect("activate", lambda _a, v: self.win and self.win.auth.logged_in and self.on_navigate(v.get_string()))
        self.add_action(nav)

    def on_navigate(self, name):
        if name == "full":
            self.win.show_full()
        elif name == "focus-info":
            w = self.win.get_focus()
            print("focus:", type(w).__name__ if w else None, flush=True)
        elif name == "focus-button":
            self.win.nav_buttons["library"].grab_focus()
        elif name == "focus-search":
            entries = [w for w in self.win.content.get_children()[0:1] if isinstance(w, Gtk.Entry)]
            if entries:
                entries[0].grab_focus()
        elif name == "liked-more":
            getattr(self.win, "_liked_more", lambda: None)()
        elif name == "sort-dialog":
            self.win.sort_dialog()
        elif name == "current-artist":
            self.win.open_current_artist()
        elif name.startswith("accent:"):
            # accent:<url copertina> | accent:default | accent:fade-on | accent:fade-off  (per i test)
            arg = name.split(":", 1)[1]
            acc = self.win.accent
            if arg in ("fade-on", "fade-off"):
                acc.fade = arg == "fade-on"
            elif arg == "bench":
                # tempo di ricalcolo stile + ridisegno per un cambio di colore
                times = []
                for i in range(10):
                    t0 = time.time()
                    acc._apply((40 + i * 20, 200 - i * 10, 120))
                    self.win.queue_draw()
                    while Gtk.events_pending():
                        Gtk.main_iteration_do(False)
                    times.append((time.time() - t0) * 1000)
                acc._apply(acc.target)
                print("bench accento ms:", " ".join(f"{t:.0f}" for t in times), flush=True)
            else:
                acc.from_cover(None if arg == "default" else arg)
            print("accento:", acc.target, flush=True)
        elif name.startswith("open:"):
            # open:<playlist|album|artist>:<id>  (per i test)
            _, kind, cid = name.split(":", 2)
            self.win.show_main()
            self.win.open(("detail", {"kind": kind, "id": cid, "uri": f"spotify:{kind}:{cid}",
                                      "name": kind.capitalize(), "subtitle": "", "image": None}))
        elif name == "recent":
            self.win.show_main()
            self.win.lib_tab = "recent"
            self.win.navigate_root(("library",))
        else:
            self.win.show_main()
            self.win.navigate_root((name,))

    def do_activate(self):
        if self.win is None:
            self.win = DeskPlayer(self)
            self.win.show_all()
            self.win.toast.hide()
            self.win.fullscreen()
            self.win.on_login_changed(self.win.auth.logged_in)
        else:
            self.win.deiconify()
            self.win.present()
            self.win.refresh_player()


if __name__ == "__main__":
    App().run(None)
