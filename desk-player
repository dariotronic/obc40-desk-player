        t = p["track"] if p else None
        self.l_title.set_text(t["name"] if t else "Niente in riproduzione")
        self.l_artist.set_text(t["artists"] if t else ("Scegli un dispositivo" if not p else ""))
        if self.full:
            self.l_album.set_text(t["album"] if t else "")
        self.l_dur.set_text(fmt(t["duration"]) if t else "0:00")
        if track_changed:
            set_image(self.art, t["image"] if t else None, self.art_size, keep=True)
        DeskPlayer.set_icon(self.b_play, "media-playback-pause-symbolic" if p and p["playing"]
                            else "media-playback-start-symbolic")
        DeskPlayer.set_on(self.b_shuffle, bool(p and p["shuffle"]))
        rep = p["repeat"] if p else "off"
        DeskPlayer.set_icon(self.b_repeat, "media-playlist-repeat-song-symbolic" if rep == "track"
                            else "media-playlist-repeat-symbolic")
