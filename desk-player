IMG_POOL = ThreadPoolExecutor(max_workers=4)
IMG_CACHE = {}
IMG_GEN = [0]  # incrementato a ogni cambio pagina: scarta i download non più visibili


def set_image(img, url, size, fallback="audio-x-generic-symbolic", keep=False):
    """Carica un'immagine remota in un Gtk.Image (asincrono, con cache)."""
    img.set_from_icon_name(fallback, Gtk.IconSize.DIALOG)
    img.set_pixel_size(min(size, 64))
    img.set_size_request(size, size)
    if not url:
        return
    key = (url, size)
    img._want = key
    if key in IMG_CACHE:
        img.set_from_pixbuf(IMG_CACHE[key])
        return

    gen = IMG_GEN[0]

    def work():
        if not keep and gen != IMG_GEN[0]:
            return  # pagina cambiata nel frattempo
        try:
            pb = download_pixbuf(url)
            if pb is None:
                return
            w, h = pb.get_width(), pb.get_height()
            s = min(w, h)
            pb = pb.new_subpixbuf((w - s) // 2, (h - s) // 2, s, s).scale_simple(size, size, GdkPixbuf.InterpType.BILINEAR)
            if len(IMG_CACHE) > 400:
                IMG_CACHE.clear()
            IMG_CACHE[key] = pb
            GLib.idle_add(lambda: getattr(img, "_want", None) == key and img.set_from_pixbuf(pb) and False)
        except Exception:
            pass
    IMG_POOL.submit(work)


def download_pixbuf(url):
    """Scarica un'immagine (ritenta sugli errori di rete temporanei). None se non disponibile."""
    req = urllib.request.Request(url, headers={"User-Agent": "desk-player/1.0"})
    data = None
    for i in range(3):
        try:
            with urllib.request.urlopen(req, timeout=15) as r:
                data = r.read()
            break
        except urllib.error.HTTPError:
            return None
        except Exception:
            time.sleep(0.6 * (i + 1))
    if data is None:
        return None
    loader = GdkPixbuf.PixbufLoader()
    loader.write(data); loader.close()
    return loader.get_pixbuf()


# ---------------- colore di accento dalla copertina ----------------

ACCENT_DEFAULT = (0xff, 0xb5, 0x47)
ACCENT_BG = (0x10, 0x11, 0x14)   # sfondo dell'app e colore del testo sui pulsanti accesi
ACCENT_MIN_CONTRAST = 4.5        # rispetto ad ACCENT_BG (soglia WCAG AA): leggibile in entrambi i sensi


def _luminance(rgb):
    def ch(c):
        c /= 255
        return c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4
    r, g, b = rgb
    return 0.2126 * ch(r) + 0.7152 * ch(g) + 0.0722 * ch(b)


def _contrast(a, b):
    la, lb = sorted((_luminance(a), _luminance(b)), reverse=True)
    return (la + 0.05) / (lb + 0.05)


ACCENT_SILVER = (0xd8, 0xda, 0xde)   # copertine neutre (bianco e nero puro)


def _readable(h, l, s):
    """Colore HLS schiarito quanto basta per il contrasto minimo con lo sfondo."""
    import colorsys
    out = None
    while l <= 0.9:
        out = tuple(round(c * 255) for c in colorsys.hls_to_rgb(h, l, s))
        if _contrast(out, ACCENT_BG) >= ACCENT_MIN_CONTRAST:
            break
        l += 0.02
    return out


def cover_accent_info(pb):
    """Colore di accento di una copertina e livello usato: "vivace", "tenue", "mista" o "argento".

    1. vivace: riduce l'immagine a 24×24, raggruppa i pixel per tonalità pesandoli per
       saturazione × luminosità (vince il colore deciso, non il fondo) e prende il gruppo più forte
       con i due vicini.
    2. tenue: se i colori decisi sono troppo pochi, cerca la tinta di fondo (seppia, fredda,
       pastello) e ne fa un colore smorzato, tanto più deciso quanto più la copertina è tinta.
       mista: come tenue, ma ci sono più tinte e nessuna prevale; se ne sceglie una a caso,
       sempre la stessa per la stessa copertina.
    3. argento: copertina davvero neutra (saturazione media sotto il 2%).
    In tutti i casi il colore è reso leggibile sullo sfondo scuro.
    """
    import colorsys
    import math
    small = pb.scale_simple(24, 24, GdkPixbuf.InterpType.BILINEAR)
    px, n, rs = small.get_pixels(), small.get_n_channels(), small.get_rowstride()
    bins, sums = [0.0] * 36, [[0.0, 0.0, 0.0] for _ in range(36)]
    tbins, tx, ty = [0.0] * 36, [0.0] * 36, [0.0] * 36   # tutte le tinte, anche deboli
    sat_sum, lit = 0.0, 0
    for y in range(24):
        for x in range(24):
            i = y * rs + x * n
            r, g, b = px[i], px[i + 1], px[i + 2]
            h, s, v = colorsys.rgb_to_hsv(r / 255, g / 255, b / 255)
            if v < 0.12:
                continue  # quasi nero: tonalità inaffidabile
            lit += 1
            sat_sum += s
            w = s * v
            k = int(h * 36) % 36
            tbins[k] += w
            tx[k] += math.cos(h * 2 * math.pi) * w; ty[k] += math.sin(h * 2 * math.pi) * w
            if s < 0.18 or v < 0.18:
                continue
            bins[k] += w
            sums[k][0] += r * w; sums[k][1] += g * w; sums[k][2] += b * w

    def strongest(bb):
        best = max(range(36), key=lambda k: bb[k - 1] + bb[k] + bb[(k + 1) % 36])
        return (best - 1, best, (best + 1) % 36)

    group = strongest(bins)
    weight = sum(bins[k] for k in group)
    if weight >= 3.0:  # almeno una decina di pixel pieni di colore
        rgb = [sum(sums[k][c] for k in group) / weight / 255 for c in range(3)]
        h, l, s = colorsys.rgb_to_hls(*rgb)
        return _readable(h, min(max(l, 0.45), 0.7), max(s, 0.6)), "vivace"
    # tinta di fondo (seppia, fredda, pastello): la tinta prevalente deve essere almeno il 40%
    # di tutta la "colorazione", altrimenti sono solo disturbi sparsi
    mean_s = sat_sum / lit if lit else 0.0
    if mean_s < 0.02:
        return ACCENT_SILVER, "argento"
    total = sum(tbins)
    group = strongest(tbins)
    tier = "tenue"
    if sum(tbins[k] for k in group) / total < 0.4:
        # più tinte, nessuna prevalente: se ne sceglie una a caso tra i picchi che pesano almeno
        # il 15%, ma sempre la stessa per la stessa copertina (il caso dipende dai pixel)
        import random
        import zlib
        peaks = []
        for k in range(36):
            g = (k - 1, k, (k + 1) % 36)
            if tbins[k] > tbins[k - 1] and tbins[k] >= tbins[(k + 1) % 36] \
                    and sum(tbins[j] for j in g) / total >= 0.15:
                peaks.append(g)
        group = random.Random(zlib.crc32(bytes(px))).choice(peaks or [group])
        tier = "mista"
    h = (math.atan2(sum(ty[k] for k in group), sum(tx[k] for k in group)) / (2 * math.pi)) % 1.0
    # più la copertina è tinta, più il colore è deciso (da ~0,2 a ~0,41 di saturazione)
    return _readable(h, 0.62, 0.15 + min(mean_s, 0.12) * 2.2), tier


def cover_accent(pb):
    return cover_accent_info(pb)[0]


class Accent:
    """Colore di accento dell'app: un foglio di stile di una riga che ridefinisce @accent."""
    STEPS, STEP_MS = 8, 50   # dissolvenza di ~0,4 s (cambio secco se il ridisegno è lento)

    def __init__(self):
        self.prov = Gtk.CssProvider()
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), self.prov,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)
        self.cur, self.target, self._anim, self.fade = ACCENT_DEFAULT, ACCENT_DEFAULT, None, True
        self.cache, self.want = {}, None
        self._apply(ACCENT_DEFAULT)

    def _apply(self, rgb):
        r, g, b = (int(round(c)) for c in rgb)
        self.prov.load_from_data(f"@define-color accent rgb({r},{g},{b});".encode())
        self.cur = (r, g, b)

    def set(self, rgb):
        rgb = tuple(rgb or ACCENT_DEFAULT)
        if rgb == self.target:
            return
        print("accento ->", "#%02x%02x%02x" % rgb, flush=True)
        self.target = rgb
        if self._anim:
            GLib.source_remove(self._anim); self._anim = None
        if not self.fade:
            self._apply(rgb)
            return
        start, step, t0, last = self.cur, [0], time.time(), [time.time()]

        def tick():
            # se un passaggio ha richiesto troppo (pagina con molti elementi, ridisegno lento)
            # si salta direttamente al colore finale: meglio un cambio secco che una sfumatura a scatti
            now = time.time()
            slow = now - last[0] > self.STEP_MS * 3 / 1000
            last[0] = now
            step[0] = self.STEPS if slow else step[0] + 1
            t = step[0] / self.STEPS
            self._apply(tuple(a + (b - a) * t for a, b in zip(start, rgb)))
            if step[0] >= self.STEPS:
                self._anim = None
                print(f"dissolvenza accento: {(time.time() - t0) * 1000:.0f} ms", flush=True)
                return False
            return True
        self._anim = GLib.timeout_add(self.STEP_MS, tick)

    def from_cover(self, url):
        """Imposta l'accento dalla copertina (in background, con cache per URL)."""
        self.want = url
        if not url:
            self.set(None)
            return
        if url in self.cache:
            self.set(self.cache[url])
            return

        def work():
            try:
                pb = download_pixbuf(url)
                rgb = cover_accent(pb) if pb is not None else None
            except Exception:
                rgb = None
            self.cache[url] = rgb
            GLib.idle_add(lambda: self.want == url and self.set(rgb) and False)
        IMG_POOL.submit(work)


