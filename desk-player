        d = p["device"] if p else None
        if d and d["volume"] is not None and pending_vol is None:
            self.volume.set_value(d["volume"])
        self.volume.set_sensitive(bool(d and d["supports_volume"] and d["volume"] is not None))
        self.l_device.set_text(f"Su: {d['name']}" if d else "")
        if not t:
            self.set_position(0, 0)
