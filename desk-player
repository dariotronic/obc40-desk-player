def page(title, body):
    return f"""<!doctype html><html><head><meta charset="utf-8"><title>{html.escape(title)}</title>
<style>body{{font-family:system-ui,sans-serif;max-width:640px;margin:40px auto;padding:0 16px;line-height:1.5}}
input{{font-size:16px;padding:6px}}button{{font-size:16px;padding:6px 14px}}code{{background:#eee;padding:2px 4px}}</style>
</head><body><h2>{html.escape(title)}</h2>{body}</body></html>"""


def make_handler(auth):
    class H(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def send(self, status, body, location=None):
            data = body.encode()
            self.send_response(status)
            if location:
                self.send_header("Location", location)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            u = urllib.parse.urlparse(self.path)
            q = {k: v[0] for k, v in urllib.parse.parse_qs(u.query).items()}
            if u.path == "/":
                cid = html.escape(auth.client_id)
                self.send(200, page("Desk Player – login Spotify", f"""
<p>1. Su <a href="https://developer.spotify.com/dashboard" target="_blank">developer.spotify.com/dashboard</a>
l'app deve avere come Redirect URI:<br><code>{REDIRECT_URI}</code></p>
<p>2. Incolla qui il suo <b>Client ID</b> (lo stesso dell'app Android va bene):</p>
<form action="/login"><input name="client_id" value="{cid}" size="40" autofocus>
<button type="submit">Accedi con Spotify</button></form>"""))
            elif u.path == "/login":
                cid = q.get("client_id", "").strip()
                if not cid:
                    self.send(400, page("Manca il Client ID", "<a href='/'>Indietro</a>"))
                else:
                    self.send(302, "", auth.authorize_url(cid))
            elif u.path == "/callback":
                if "error" in q:
                    self.send(400, page("Spotify ha rifiutato il login", html.escape(q["error"])))
                elif "code" not in q:
                    self.send(400, page("Risposta non valida", ""))
                else:
                    try:
                        auth.callback(q["code"], q.get("state"))
                        self.send(200, page("Fatto!", "Il display è collegato al tuo account. Puoi chiudere questa pagina."))
                    except Exception as e:
                        self.send(500, page("Errore", html.escape(str(e))))
            else:
                self.send(404, page("Non trovato", ""))
    return H


