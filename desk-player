        card.set_size_request(380, -1)
        card_ev.add(card)
        shade.add(card_ev)

        pending = {"mode": self.sort_mode, "desc": self.sort_desc}

        def close(*_):  # tocco fuori: annulla
            shade.destroy()
            self._sort_modal = None
            return True
        shade.connect("button-release-event", close)

        def apply(*_):
            close()
            if (pending["mode"], pending["desc"]) == (self.sort_mode, self.sort_desc):
                return
            self.state["sort"], self.state["sort_desc"] = pending["mode"], pending["desc"]
            save_json(STATE_FILE, self.state)
            if self.sort_mode == "recent":
                self.bg(self.api.recent_map, lambda _r: self.render() and False)
            else:
                self.render()

        card.pack_start(label("Ordina per", "dtitle"), False, False, 4)
        rows = {}

        def refresh():
            for key, (btn, img) in rows.items():
                on = key == pending["mode"]
                (btn.get_style_context().add_class if on else btn.get_style_context().remove_class)("sel")
                img.set_from_icon_name(self.arrow_icon(pending["desc"]), Gtk.IconSize.BUTTON)
                img.set_pixel_size(22)
                img.set_opacity(1.0 if on else 0.0)

        def choose(key):
            if key == pending["mode"]:
                pending["desc"] = not pending["desc"]   # stessa voce: inverte la freccia
            else:
                pending["mode"], pending["desc"] = key, self.SORT_DEFAULT_DESC[key]
            refresh()

        avail = getattr(self, "page_sorts", self.ALL_SORTS)
        for key, name in self.SORTS:
            if key not in avail:
                continue
            if key == "recent":
                name = "Ascoltato (ultimi 50 ascolti)"
            btn = Gtk.Button()
            btn.get_style_context().add_class("sortopt")
            hb = Gtk.Box(spacing=10)
            hb.pack_start(Gtk.Label(label=name, xalign=0), True, True, 0)
            img = Gtk.Image()
            hb.pack_end(img, False, False, 0)
            btn.add(hb)
