    def build_now_playing(self):
        self.np_side = NowPlayingView(self)
        return self.np_side.root

    def show_full(self):
        self.views.set_visible_child_name("full")

    def show_main(self):
        if self.auth.logged_in:
            self.views.set_visible_child_name("main")

    # ---------------- login / server ----------------

    def local_ip(self):
        try:
            import socket
            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            s.connect(("192.0.2.1", 9)); ip = s.getsockname()[0]; s.close()
            return ip
        except OSError:
            return "<ip-scheda>"

    def start_server(self):
        """Il server di login (solo 127.0.0.1) resta acceso finché non c'è un account collegato."""
        if self.server:
            return
        try:
            self.server = ThreadingHTTPServer(("127.0.0.1", PORT), make_handler(self.auth))
            threading.Thread(target=self.server.serve_forever, daemon=True).start()
        except OSError as e:
            print("server di login non avviato:", e)

    def stop_server(self):
        srv, self.server = self.server, None
        if srv:
            # shutdown() aspetta il giro del server: fuori dal thread della UI
            threading.Thread(target=lambda: (srv.shutdown(), srv.server_close()), daemon=True).start()

    def on_login_changed(self, logged):
        self.views.set_visible_child_name("main" if logged else "login")
        (self.stop_server if logged else self.start_server)()
        if logged:
            self.cache.clear()
            self.render()
            self.refresh_player()
        else:
            self.player = None
        return False

    def go_home(self):
        """Riduce a icona l'app: torna a quello che c'è dietro (desktop o altra schermata principale)."""
        self.iconify()

    # ---------------- utilità asincrone ----------------

    def bg(self, fn, done=None, fail=None):
        def work():
            try:
                res = fn()
            except Exception as e:  # noqa: BLE001
                GLib.idle_add(lambda err=e: (fail or self.on_error)(err) and False)
                return
            if done:
                GLib.idle_add(lambda r=res: done(r) and False)
        threading.Thread(target=work, daemon=True).start()

    def on_error(self, e):
        if isinstance(e, NotLoggedIn):
            return False
        if isinstance(e, ApiError) and e.status == 429:
            # un solo avviso per ogni blocco, non uno a ogni tocco
            if time.time() < self.rl_toast_until:
                return False
            self.rl_toast_until = self.api.blocked_until
        self.show_toast(str(e) or "Errore di rete")
        if isinstance(e, ApiError) and e.reason == "NO_ACTIVE_DEVICE":
            self.navigate_root(("devices",))
        return False

    def show_toast(self, text):
        self.toast.set_text(text); self.toast.show()
        tid = object(); self._toast_id = tid
        GLib.timeout_add(3500, lambda: (getattr(self, "_toast_id", None) is tid and self.toast.hide()) and False)

    def act(self, fn, hold=1.2):
        self.last_activity = time.time()

        def run():
            fn()
            return True
        def done(_):
            self.hold_until = time.time() + hold
            GLib.timeout_add(int(hold * 1000), lambda: (setattr(self, "hold_until", 0), self.refresh_player(force=True)) and False)
            return False
        def fail(e):
            self.hold_until = 0
            return self.on_error(e)
        self.bg(run, done, fail)

    def target_device(self):
        return self.state.get("last_device") if not (self.player and self.player.get("device")) else None

    # ---------------- player ----------------

    def poll_interval(self):
        """Secondi tra due letture del player: 2 in riproduzione, 5 in pausa, 15 dopo 10 minuti fermo."""
        if self.player and self.player["playing"]:
            return 2
        return 15 if time.time() - self.last_activity > 600 else 5

    def poll_timer(self):
        now = time.time()
        # niente letture da ridotta a icona o durante un blocco per rate limit
        if (self.auth.logged_in and self.get_visible() and not self.iconified
                and now >= self.next_poll and not self.api.rate_limited()):
            self.refresh_player()
        return True

    def on_window_state(self, _win, event):
        was = self.iconified
        self.iconified = bool(event.new_window_state & Gdk.WindowState.ICONIFIED)
        # di nuovo in primo piano: aggiorna subito, se non l'ha appena fatto do_activate
        # (l'evento della finestra può arrivare anche un paio di secondi dopo)
        if was and not self.iconified and time.time() - self.last_refresh > 3:
            self.refresh_player()
        return False

    def refresh_player(self, force=False):
        if not self.auth.logged_in:
            return False
        now = time.time()
        if not force and now - self.last_refresh < 1:
            return False  # due richieste ravvicinate (es. riapertura della finestra): ne basta una
        # ogni lettura, anche quelle fuori dal timer, sposta in avanti la successiva
        self.last_refresh, self.next_poll = now, now + self.poll_interval()

        known_uri = self.player["track"]["uri"] if self.player and self.player["track"] else None

        def fetch():
            p = self.api.player()
            uri = p["track"]["uri"] if p and p["track"] else None
            liked = None
            # lo stato del cuore si rilegge a ogni cambio di brano (può cambiare da un altro dispositivo)
            if uri and uri.startswith("spotify:track:") and self.can_like() and (
                    uri != known_uri or uri not in self.saved):
                try:
                    liked = self.api.in_library([uri]).get(uri)
                except ApiError:
                    pass
            return p, (uri, liked)

        def done(res):
            p, (uri, liked) = res
            if liked is not None:
                self.saved[uri] = liked
            if time.time() < self.hold_until:
                return False
            old_uri = self.player["track"]["uri"] if self.player and self.player["track"] else None
            self.player = p
            if p and p["playing"]:
                self.last_activity = time.time()
            self.warn_missing_scopes()
            if p and p["device"] and p["device"]["id"] and p["device"]["id"] != self.state.get("last_device"):
                self.state["last_device"] = p["device"]["id"]
                save_json(STATE_FILE, self.state)
            new_uri = p["track"]["uri"] if p and p["track"] else None
            self.update_player_ui(track_changed=new_uri != old_uri)
            # brano "rimosso" dalla coda: saltalo appena parte
            if new_uri and new_uri != old_uri and new_uri in self.skip_uris:
                self.skip_uris.remove(new_uri)
                self.act(self.api.next, hold=0.8)
            elif new_uri != old_uri and self.stack[-1][0] == "queue":
                self.render()
            return False
        self.bg(fetch, done, lambda e: False)
        return False

    def position(self):
        p = self.player
        if not p:
            return 0
        pos = p["progress"] + ((time.time() - p["fetched"]) * 1000 if p["playing"] else 0)
        dur = p["track"]["duration"] if p["track"] else 0
        return max(0, min(pos, dur)) if dur else pos

    def tick(self):
        p = self.player
        if p and p["track"] and self.pending_seek is None:
            pos = self.position()
            for np in self.panels:
                np.set_position(pos, p["track"]["duration"])
        return True

    def current_liked(self):
        """Stato del cuore per il brano in riproduzione (None: niente cuore)."""
        t = self.player["track"] if self.player else None
        if not t or not t["uri"].startswith("spotify:track:") or not self.can_like():
            return None
        return self.saved.get(t["uri"], False)

    def update_player_ui(self, track_changed=False):
        for np in self.panels:
            np.update(self.player, self.current_liked(), track_changed, self.pending_vol)
        if track_changed:
            self.highlight_current()
            t = self.player["track"] if self.player else None
            self.accent.from_cover((t.get("small") or t.get("image")) if t else None)

    @staticmethod
    def set_icon(btn, name):
        btn._img.set_from_icon_name(name, Gtk.IconSize.BUTTON)

    @staticmethod
    def set_on(btn, on):
        ctx = btn.get_style_context()
        (ctx.add_class if on else ctx.remove_class)("on")

    # azioni
    def toggle_play(self):
        p = self.player
        playing = bool(p and p["playing"])
        if p:
            p["progress"] = self.position(); p["fetched"] = time.time(); p["playing"] = not playing
            self.update_player_ui()
        dev = self.target_device()
        self.act(self.api.pause if playing else (lambda: self.api.play(dev)))

    def toggle_shuffle(self):
        on = not (self.player and self.player["shuffle"])
        if self.player:
            self.player["shuffle"] = on; self.update_player_ui()
        self.act(lambda: self.api.shuffle(on))

    def cycle_repeat(self):
        nxt = {"off": "context", "context": "track"}.get(self.player["repeat"] if self.player else "off", "off")
        if self.player:
            self.player["repeat"] = nxt; self.update_player_ui()
        self.act(lambda: self.api.repeat(nxt))

    def on_seek(self, _scale, _scroll, value):
        p = self.player
        if not p or not p["track"]:
            return True
        dur = p["track"]["duration"]
        self.pending_seek = max(0.0, min(1.0, value)) * dur
        for np in self.panels:
            np.l_pos.set_text(fmt(self.pending_seek))
        tid = object(); self._seek_id = tid

        def send():
            if getattr(self, "_seek_id", None) is not tid or self.pending_seek is None:
                return False
            ms = self.pending_seek
            self.pending_seek = None
            if self.player:
                self.player["progress"] = ms; self.player["fetched"] = time.time()
            self.act(lambda: self.api.seek(ms))
            return False
        GLib.timeout_add(450, send)
        return False

    def on_volume(self, _scale, _scroll, value):
        self.pending_vol = max(0, min(100, int(value)))
        tid = object(); self._vol_id = tid

        def send():
            if getattr(self, "_vol_id", None) is not tid or self.pending_vol is None:
                return False
            v = self.pending_vol
            self.pending_vol = None
            if self.player and self.player["device"]:
                self.player["device"]["volume"] = v
            self.act(lambda: self.api.volume(v))
            return False
        GLib.timeout_add(350, send)
        return False

    def play_context(self, ctx, uri=None):
        dev = self.target_device()
        self.act(lambda: self.api.play_context(ctx, uri, dev))

    def play_track(self, t, ctx=None, liked=False):
        """Riproduce un brano dentro un contesto (album o Brani che ti piacciono).

        Le richieste con una lista di URI vengono accettate da Spotify ma non partono
        su alcuni client Connect, quindi si usa sempre un contesto con offset."""
        dev = self.target_device()

        def run():
            c = ctx or (f"spotify:user:{self.api.me_id()}:collection" if liked else t.get("album_uri"))
            if c:
                self.api.play_context(c, t["uri"], dev)
            else:
                self.api.play(dev, {"uris": [t["uri"]]})
        self.act(run)

    LIKE_SCOPES = {"user-library-read", "user-library-modify"}

    def can_like(self):
        return not (self.auth.missing_scopes() & self.LIKE_SCOPES)

    def warn_missing_scopes(self):
        """Una volta per sessione: se il token non ha tutti gli scope di questa versione, lo dice."""
        if self.scope_warned or not self.auth.missing_scopes():
            return
        self.scope_warned = True
        self.show_toast("Per alcune funzioni serve un nuovo accesso: Dispositivi → Esci dall'account, poi ricollegati")

    def toggle_like(self):
        t = self.player["track"] if self.player else None
        if t:
            self.toggle_saved(t)

    def toggle_saved(self, t):
        """Mette o toglie il brano dai Preferiti: il cuore cambia subito, torna indietro se Spotify rifiuta."""
        uri = t["uri"]
        on = not self.saved.get(uri, False)
        self.saved[uri] = on
        self.refresh_likes(uri)

        def done(_):
            self.liked_state = None  # la pagina Preferiti va riletta
            self.show_toast(f"Aggiunto ai Preferiti: {t['name']}" if on else f"Tolto dai Preferiti: {t['name']}")
            return False

        def fail(e):
            self.saved[uri] = not on
            self.refresh_likes(uri)
            return self.on_error(e)
        self.bg(lambda: self.api.set_in_library(uri, on), done, fail)

    def register_like(self, uri, btn):
        self.like_buttons.append((uri, btn))
        set_like(btn, self.saved.get(uri, False))

    def refresh_likes(self, uri):
        for u, b in self.like_buttons:
            if u == uri:
                set_like(b, self.saved.get(u, False))
        cur = self.current_liked()
        for np in self.panels:
            np.set_liked(cur)

    def with_saved(self, fn, tracks_of, limit=200):
        """Dopo il caricamento legge quali brani sono nei Preferiti (al massimo `limit`, 40 per richiesta)."""
        def run():
            data = fn()
            if self.can_like():
                uris = [t["uri"] for t in tracks_of(data) if t and t["uri"].startswith("spotify:track:")]
                todo = [u for u in dict.fromkeys(uris) if u not in self.saved][:limit]
                try:
                    self.saved.update(self.api.in_library(todo))
                except ApiError:
                    pass
            return data
        return run

    def enqueue(self, t):
        def done(_):
            self.show_toast(f"Aggiunto alla coda: {t['name']}")
            if self.stack[-1][0] == "queue":
                GLib.timeout_add(700, lambda: self.stack[-1][0] == "queue" and self.render() and False)
            return False
        self.bg(lambda: self.api.enqueue(t["uri"]), done)

    def unqueue(self, t):
        """L'API Spotify non permette di togliere brani dalla coda: il brano viene
        nascosto e saltato automaticamente quando arriva il suo turno."""
        self.skip_uris.append(t["uri"])
        self.show_toast(f"Rimosso dalla coda: {t['name']}")
        if self.stack[-1][0] == "queue":
            self.render()

    def filter_queue(self, queue):
        pending = list(self.skip_uris)
        out = []
        for t in queue:
            if t["uri"] in pending:
                pending.remove(t["uri"])
            else:
                out.append(t)
        return out

    def transfer(self, d):
        if not d["id"]:
            return
        self.state["last_device"] = d["id"]; save_json(STATE_FILE, self.state)
        self.act(lambda: self.api.transfer(d["id"]))

