    def sorted_items(self, items):
        """Ordina secondo la scelta dell'utente; gli elementi senza dato finiscono sempre in fondo.

        ↑ è sempre l'esatto rovescio di ↓, anche a parità di valore (es. brani di una playlist
        aggiunti tutti insieme): a parità, ↓ tiene l'ordine di Spotify e ↑ lo inverte.
        """
        mode, desc = self.sort_mode, self.sort_desc
        items = list(items)
        if mode == "alpha":
            val = lambda x: x["name"].casefold()  # noqa: E731
        elif mode == "recent":
            m = self.api.recent_by_uri
            val = lambda x: m.get(x.get("uri"), "")  # noqa: E731
        elif mode == "added":
            if not any(x.get("added") for x in items):
                # playlist della libreria: l'API non dà la data, ma le restituisce
                # dalla più recente nella libreria
                return items if desc else items[::-1]
            val = lambda x: x.get("added") or ""  # noqa: E731
        else:
            val = lambda x: x.get("date") or ""  # noqa: E731
        known = [x for x in items if val(x)]
        rest = [x for x in items if not val(x)]
        # sort stabile nella direzione "naturale" (A→Z per il nome, più recente prima per le date):
        # a parità resta l'ordine di Spotify; la direzione opposta è il rovescio esatto
        natural_desc = mode != "alpha"
        out = sorted(known, key=val, reverse=natural_desc)
        if desc != natural_desc:
            out.reverse()
        return out + rest

    def with_recent(self, fn):
        """Se l'ordinamento è per ascolto, carica anche la mappa degli ascolti recenti."""
        if self.sort_mode != "recent":
            return fn

        def run():
            data = fn()
            try:
                self.api.recent_map()
            except Exception:
                pass
            return data
        return run

