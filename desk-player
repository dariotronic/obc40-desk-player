            card.pack_start(btn, False, False, 0)
            rows[key] = (btn, img)
        card.pack_start(label("Tocca di nuovo la voce scelta per invertire la freccia", "rsub",
                              ellipsize=False, wrap=True), False, False, 4)
        done = Gtk.Button(label="Fatto")
        done.get_style_context().add_class("chip")
        done.get_style_context().add_class("sel")
        done.connect("clicked", apply)
        card.pack_start(done, False, False, 6)
        self.overlay.add_overlay(shade)
        shade.show_all()
        refresh()
        self._sort_modal = shade

