            if data["colls"]:
                self.add_header(lb, "Album e playlist")
                self.add_colls(lb, [dict(c, subtitle=" · ".join(v for v in (c["subtitle"], played_label(c["played"])) if v))
                                    for c in data["colls"]])
            tracks = data["tracks"]
            if tracks:
                self.add_header(lb, "Brani")
                self.add_tracks(lb, tracks, lambda i: self.play_track(tracks[i]))
            if not data["colls"] and not tracks:
                self.empty(lb, "Nessun ascolto recente")
        self.load(self.content, None, self.with_saved(self.api.recent_overview, lambda d: d["tracks"]), build)

    def reload_library(self):
        self.cache.pop("lib:" + self.lib_tab, None)
        self.liked_state = None
        self.render()

    def page_search(self):
        entry = Gtk.SearchEntry()
        entry.set_placeholder_text("Brani, artisti, album, playlist")
        entry.set_text(self.search_text)
        entry.set_margin_start(14); entry.set_margin_end(14); entry.set_margin_top(6)
        self.content.pack_start(entry, False, False, 0)
        results = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.content.pack_start(results, True, True, 0)

        def run_search(*_):
            q = entry.get_text().strip()
            self.search_text = q
            for c in results.get_children():
                results.remove(c); c.destroy()
            self.track_labels = []
            if not q:
                return

            def build(container, r):
                lb = self.scrolled_list(container)
                if r["tracks"]:
                    self.add_header(lb, "Brani")
                    self.add_tracks(lb, r["tracks"], lambda i: self.play_track(r["tracks"][i]))
                for key, title in (("artists", "Artisti"), ("albums", "Album"), ("playlists", "Playlist")):
                    if r[key]:
                        self.add_header(lb, title); self.add_colls(lb, r[key])
                if not any(r.values()):
                    self.empty(lb, "Nessun risultato")
            self.token += 1
            self.load(results, "search:" + q, self.with_saved(lambda: self.api.search(q), lambda r: r["tracks"]), build)
        entry.connect("search-changed", run_search)  # GTK aspetta già ~150 ms dopo la digitazione
        # niente focus automatico: la tastiera si apre solo toccando il campo di testo
        if self.search_text:
            GLib.idle_add(lambda: run_search() and False)

    def page_queue(self):
        def build(container, data):
            cur, queue = data
            lb = self.scrolled_list(container, force_list=True)
            self.add_header(lb, "In riproduzione")
            if cur:
                self.add_tracks(lb, [cur], None)
            else:
                self.empty(lb, "Niente")
            self.add_header(lb, "Prossimi")
            queue = self.filter_queue(queue)
            if not queue:
                self.empty(lb, "La coda è vuota")
            self.add_tracks(lb, queue, None, removable=True)
        h = Gtk.Box(); h.set_margin_start(14)
        h.pack_end(icon_button("view-refresh-symbolic", self.render, tip="Aggiorna"), False, False, 8)
        self.content.pack_start(h, False, False, 0)
        self.load(self.content, None, self.with_saved(self.api.queue, lambda d: [d[0]] + d[1]), build)

    def check_updates(self):
        obc_update.UpdateDialog(self.overlay, NAME, REPO, APP_DIR, WRAPPER,
                                quit_cb=self.get_application().quit, accent="@accent").start()

    def page_devices(self):
        h = Gtk.Box(spacing=8); h.set_margin_start(14); h.set_margin_top(4)
