def load_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def private_conf_dir():
    """La cartella con login e preferenze è leggibile solo dall'utente (700), anche se esisteva già."""
    os.makedirs(CONF_DIR, mode=0o700, exist_ok=True)
    try:
        os.chmod(CONF_DIR, 0o700)
    except OSError:
        pass


def save_json(path, data):
    private_conf_dir()
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


