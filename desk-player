        foot = Gtk.Box(spacing=10)
        foot.set_margin_start(16); foot.set_margin_end(12); foot.set_margin_bottom(8)
        foot.pack_start(label(f"Desk Player {obc_update.read_version(APP_DIR)}", "rsub", ellipsize=False), False, False, 0)
        upd = Gtk.Button()
        ub = Gtk.Box(spacing=6)
        ui = Gtk.Image.new_from_icon_name("view-refresh-symbolic", Gtk.IconSize.BUTTON)
