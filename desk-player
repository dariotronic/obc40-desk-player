class NotLoggedIn(Exception):
    pass


class ApiError(Exception):
    def __init__(self, status, reason, message):
        super().__init__(message)
        self.status, self.reason = status, reason


class Auth:
    def __init__(self, on_login):
        self.data = load_json(AUTH_FILE)
        self.lock = threading.Lock()
        self.pending = None  # (verifier, state)
        self.on_login = on_login

    @property
    def logged_in(self):
        return bool(self.data.get("refresh_token"))

    @property
    def client_id(self):
        return self.data.get("client_id", "")

    def authorize_url(self, client_id):
        self.data["client_id"] = client_id
        save_json(AUTH_FILE, self.data)
        verifier = secrets.token_urlsafe(64)[:96]
        state = secrets.token_urlsafe(16)
        self.pending = (verifier, state)
        challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
        q = urllib.parse.urlencode({
            "client_id": client_id, "response_type": "code", "redirect_uri": REDIRECT_URI,
            "code_challenge_method": "S256", "code_challenge": challenge, "state": state, "scope": SCOPES,
        })
        return "https://accounts.spotify.com/authorize?" + q

    def callback(self, code, state):
        if not self.pending or state != self.pending[1]:
            raise RuntimeError("Sessione di login non valida, riprova da capo")
        self._token_request({
            "grant_type": "authorization_code", "code": code, "redirect_uri": REDIRECT_URI,
            "client_id": self.client_id, "code_verifier": self.pending[0],
        })
        self.pending = None
        GLib.idle_add(self.on_login, True)

    def _token_request(self, form):
        req = urllib.request.Request("https://accounts.spotify.com/api/token",
                                     data=urllib.parse.urlencode(form).encode(), method="POST")
        try:
            with urllib.request.urlopen(req, timeout=15) as r:
                j = json.loads(r.read().decode())
        except urllib.error.HTTPError as e:
            body = e.read().decode(errors="replace")
            raise RuntimeError(f"Token {e.code}: {body}") from None
        self.data["access_token"] = j["access_token"]
        self.data["expires_at"] = time.time() + j.get("expires_in", 3600) - 60
        if j.get("refresh_token"):
            self.data["refresh_token"] = j["refresh_token"]
        if j.get("scope") is not None:
            self.data["scope"] = j["scope"]  # gli scope concessi: un vecchio token non ha quelli nuovi
        save_json(AUTH_FILE, self.data)

    def token(self, force=False):
        with self.lock:
            if not force and self.data.get("access_token") and time.time() < self.data.get("expires_at", 0):
                return self.data["access_token"]
            if not self.logged_in:
                raise NotLoggedIn()
            try:
                self._token_request({"grant_type": "refresh_token",
                                     "refresh_token": self.data["refresh_token"],
                                     "client_id": self.client_id})
            except RuntimeError as e:
                if "invalid_grant" in str(e):
                    self.logout()
                    raise NotLoggedIn() from None
                raise
            return self.data["access_token"]

    def missing_scopes(self):
        """Scope richiesti da questa versione ma non concessi al token (vuoto se non si sa ancora)."""
        granted = self.data.get("scope")
        if granted is None:
            return set()
        return set(SCOPES.split()) - set(granted.split())

    def logout(self):
        for k in ("access_token", "refresh_token", "expires_at", "scope"):
            self.data.pop(k, None)
        save_json(AUTH_FILE, self.data)
        GLib.idle_add(self.on_login, False)


def img_urls(j):
    imgs = (j or {}).get("images") or []
    if not imgs:
        return None, None
    return imgs[0].get("url"), imgs[-1].get("url")


def parse_track(j, fallback_image=None, album_name=None, album_uri=None):
    if not j or not j.get("uri"):
        return None
    if j.get("type") == "episode":
        big, small = img_urls(j)
        artists = (j.get("show") or {}).get("name", "")
        album = artists
        ctx = (j.get("show") or {}).get("uri")
    else:
        big, small = img_urls(j.get("album"))
        artists = ", ".join(a.get("name", "") for a in j.get("artists") or [])
        album = (j.get("album") or {}).get("name", "")
        ctx = (j.get("album") or {}).get("uri")
    artist_list = [(a.get("id"), a.get("name", "")) for a in j.get("artists") or [] if a.get("id")]
    return {"id": j.get("id"), "uri": j["uri"], "name": j.get("name") or "?", "artists": artists,
            "album": album_name or album, "image": big or fallback_image, "small": small or fallback_image,
            "duration": j.get("duration_ms") or 0, "album_uri": album_uri or ctx, "artist_list": artist_list,
            "added": "", "date": (j.get("album") or {}).get("release_date") or ""}


def parse_coll(j, kind):
    if not j or not j.get("id"):
        return None
    big, small = img_urls(j)
    if kind == "playlist":
        sub = (j.get("owner") or {}).get("display_name") or ""
    elif kind == "album":
        sub = ", ".join(a.get("name", "") for a in j.get("artists") or [])
    else:
        sub = "Artista"
    c = {"kind": kind, "id": j["id"], "uri": j.get("uri", ""), "name": j.get("name") or "?",
         "subtitle": sub, "image": small or big}
    if kind == "album":
        c["date"] = j.get("release_date") or ""
        c["type"] = release_type(j)
    return c


def release_type(j):
    t = j.get("album_type") or ""
    if t == "album":
        return "Album"
    if t == "compilation":
        return "Raccolta"
    # l'API chiama "single" anche gli EP: Spotify considera EP le uscite da 4 a 6 brani
    return "EP" if (j.get("total_tracks") or 0) >= 4 else "Singolo"


MONTHS = ("gen", "feb", "mar", "apr", "mag", "giu", "lug", "ago", "set", "ott", "nov", "dic")


def played_label(iso):
    """Orario di un ascolto (ISO 8601 in UTC) nel fuso locale: "oggi 10:12", "ieri 23:40", "9 nov"."""
    try:
        dt = datetime.datetime.fromisoformat(iso.replace("Z", "+00:00")).astimezone()
    except (AttributeError, ValueError):
        return ""
    days = (datetime.date.today() - dt.date()).days
    if days == 0:
        return dt.strftime("oggi %H:%M")
    if days == 1:
        return dt.strftime("ieri %H:%M")
    return f"{dt.day} {MONTHS[dt.month - 1]}"


def fmt_long(ms):
    m = int(ms // 60000)
    return f"{m // 60} h {m % 60} min" if m >= 60 else f"{m} min"


def detail_info(prefix, date, tracks, created=False):
    parts = [x for x in (prefix,) if x]
    if date:
        parts.append(("creata nel " if created else "") + date[:4])
    n = len(tracks)
    parts.append(f"{n} {'brano' if n == 1 else 'brani'}")
    parts.append(fmt_long(sum(t["duration"] for t in tracks)))
    return " · ".join(parts)


def parse_device(j):
    if not j:
        return None
    return {"id": j.get("id"), "name": j.get("name") or "?", "type": (j.get("type") or "").lower(),
            "active": bool(j.get("is_active")), "volume": j.get("volume_percent"),
            "supports_volume": j.get("supports_volume", True)}


class Spotify:
    MAX_BACKOFF = 60

    def __init__(self, auth):
        self.auth = auth
        self.blocked_until = 0  # dopo un 429 nessuna chiamata parte prima di questo istante
        self.backoff = 0        # ultima attesa usata quando manca Retry-After (secondi)
        self.rl_lock = threading.Lock()
        self._recent = (0, None)
        self.recent_by_uri = {}  # ultima mappa calcolata da recent_map(), letta dall'ordinamento
        self._ctx_cache = {}     # URI di album/playlist -> (istante, scheda), per i contesti degli ascolti

    def rate_limited(self):
        """Secondi che mancano alla fine del blocco per rate limit (0 se non c'è)."""
        return max(0, self.blocked_until - time.time())

    def _throttle(self, retry_after):
        """Su un 429: rispetta Retry-After, altrimenti backoff esponenziale con jitter."""
        with self.rl_lock:
            try:
                wait = max(1.0, float(retry_after))
            except (TypeError, ValueError):
                self.backoff = min(self.MAX_BACKOFF, self.backoff * 2 or 1)
                wait = self.backoff + random.uniform(0, self.backoff / 2)
            self.blocked_until = max(self.blocked_until, time.time() + wait)
            return self.blocked_until - time.time()

    @staticmethod
    def _open(req, retries):
        """Esegue la richiesta; ritenta sugli errori di rete temporanei (es. DNS "Try again")."""
        for i in range(retries):
            try:
                with urllib.request.urlopen(req, timeout=15) as r:
                    return r.read().decode(errors="replace")
            except urllib.error.HTTPError:
                raise
            except (urllib.error.URLError, TimeoutError, ConnectionError):
                if i == retries - 1:
                    raise
                time.sleep(0.6 * (i + 1))

    def call(self, method, path, body=None):
        wait = self.rate_limited()
        if wait:
            raise ApiError(429, None, f"Spotify chiede di rallentare: riprovo tra {math.ceil(wait)} s")
        for attempt in range(2):
            token = self.auth.token(force=attempt > 0)
            data = json.dumps(body).encode() if body is not None else (b"" if method != "GET" else None)
            req = urllib.request.Request(path if path.startswith("http") else API + path, data=data, method=method,
                                         headers={"Authorization": f"Bearer {token}",
                                                  "Content-Type": "application/json"})
            try:
                text = self._open(req, retries=3 if method == "GET" else 1)
                self.backoff = 0
                # alcuni comandi (es. pausa) rispondono con testo non JSON: va bene lo stesso
                try:
                    return json.loads(text) if text.strip() else None
                except ValueError:
                    return None
            except urllib.error.HTTPError as e:
                text = e.read().decode(errors="replace")
                if e.code == 401 and attempt == 0:
                    continue
                try:
                    err = json.loads(text).get("error") or {}
                except ValueError:
                    err = {}
                reason = err.get("reason") if isinstance(err, dict) else None
                if reason == "NO_ACTIVE_DEVICE":
                    msg = "Nessun dispositivo attivo: scegline uno"
                elif reason == "PREMIUM_REQUIRED":
                    msg = "Serve Spotify Premium"
                elif e.code == 429:
                    wait = self._throttle(e.headers.get("Retry-After"))
                    msg = f"Spotify chiede di rallentare: riprovo tra {math.ceil(wait)} s"
                else:
                    msg = (err.get("message") if isinstance(err, dict) else None) or f"Errore {e.code}"
                raise ApiError(e.code, reason, msg) from None
        raise ApiError(401, None, "Accesso non autorizzato")

    # --- player ---
    def player(self):
        j = self.call("GET", "me/player?additional_types=episode")
        if not j:
            return None
        return {"playing": bool(j.get("is_playing")), "track": parse_track(j.get("item")),
                "progress": j.get("progress_ms") or 0, "fetched": time.time(),
                "shuffle": bool(j.get("shuffle_state")), "repeat": j.get("repeat_state") or "off",
                "device": parse_device(j.get("device")), "context": (j.get("context") or {}).get("uri")}

    def devices(self):
        return [d for d in (parse_device(x) for x in (self.call("GET", "me/player/devices") or {}).get("devices", [])) if d]

    def _dev(self, device_id):
        return f"?device_id={urllib.parse.quote(device_id)}" if device_id else ""

    def play(self, device_id=None, body=None):
        self.call("PUT", "me/player/play" + self._dev(device_id), body)

    def pause(self): self.call("PUT", "me/player/pause")
    def next(self): self.call("POST", "me/player/next")
    def previous(self): self.call("POST", "me/player/previous")
    def seek(self, ms): self.call("PUT", f"me/player/seek?position_ms={int(ms)}")
    def volume(self, pct): self.call("PUT", f"me/player/volume?volume_percent={int(pct)}")
    def shuffle(self, on): self.call("PUT", f"me/player/shuffle?state={'true' if on else 'false'}")
    def repeat(self, state): self.call("PUT", f"me/player/repeat?state={state}")
    def transfer(self, device_id): self.call("PUT", "me/player", {"device_ids": [device_id], "play": True})
    def enqueue(self, uri): self.call("POST", "me/player/queue?uri=" + urllib.parse.quote(uri))

    def play_context(self, ctx, offset_uri, device_id):
        body = {"context_uri": ctx}
        if offset_uri:
            body["offset"] = {"uri": offset_uri}
        self.play(device_id, body)

    def play_uris(self, uris, offset, device_id):
        self.play(device_id, {"uris": uris, "offset": {"position": offset}})

    def queue(self):
        j = self.call("GET", "me/player/queue") or {}
        return parse_track(j.get("currently_playing")), [t for t in map(parse_track, j.get("queue") or []) if t]

    # --- libreria ---
    def playlists(self):
        items = self.all_items(self.call("GET", "me/playlists?limit=50"), max_pages=10)
        return [c for c in (parse_coll(x, "playlist") for x in items) if c]

    def albums(self):
        out = []
        for x in self.all_items(self.call("GET", "me/albums?limit=50"), max_pages=10):
            c = parse_coll(x.get("album"), "album")
            if c:
                c["added"] = (lambda v: "" if not v or v.startswith("1970") else v)(x.get("added_at"))
                out.append(c)
        return out

    def artists(self):
        out, path, n = [], "me/following?type=artist&limit=50", 0
        while path and n < 10:
            j = (self.call("GET", path) or {}).get("artists") or {}
            out += [c for c in (parse_coll(x, "artist") for x in j.get("items", [])) if c]
            path, n = j.get("next"), n + 1
        return out

    def liked_page(self, offset, limit=50):
        """Una pagina di "Brani che ti piacciono" (ordine Spotify: aggiunti più di recente prima)."""
        j = self.call("GET", f"me/tracks?limit={limit}&offset={offset}") or {}
        out = []
        for x in j.get("items", []):
            t = parse_track(x.get("track"))
            if t:
                t["added"] = (lambda v: "" if not v or v.startswith("1970") else v)(x.get("added_at"))
                out.append(t)
        return out, j.get("total") or 0

    def recent_items(self, max_age=120):
        """Gli ultimi 50 ascolti: una sola lettura, riusata per max_age secondi."""
        fetched, items = self._recent
        if items is None or time.time() - fetched >= max_age:
            items = (self.call("GET", "me/player/recently-played?limit=50") or {}).get("items", [])
            self._recent = (time.time(), items)
        return items

    def recent_map(self):
        """URI -> ultimo ascolto (brani, album, playlist, artisti) dagli ultimi 50 ascolti."""
        m = {}
        for x in self.recent_items():
            ts, t = x.get("played_at") or "", x.get("track") or {}
            keys = [t.get("uri"), (t.get("album") or {}).get("uri"), (x.get("context") or {}).get("uri")]
            keys += [a.get("uri") for a in t.get("artists") or []]
            for k in keys:
                if k and ts > m.get(k, ""):
                    m[k] = ts
        self.recent_by_uri = m
        return m

    def recent_overview(self, max_age=15, max_colls=12):
        """Scheda "Recenti": album e playlist da cui sono partiti gli ultimi 50 ascolti, poi i brani.

        Ogni elemento ha "played", l'orario dell'ascolto più recente. Album e playlist vengono dal
        contesto dell'ascolto, quindi compaiono anche se non sono salvati in libreria."""
        items = self.recent_items(max_age=max_age)
        colls, seen_c, tracks, seen_t = [], set(), [], set()
        for x in items:
            when = x.get("played_at") or ""
            t = parse_track(x.get("track"))
            if t and t["uri"] not in seen_t:
                seen_t.add(t["uri"])
                t["played"] = when
                tracks.append(t)
            ctx = x.get("context") or {}
            kind, uri = ctx.get("type"), ctx.get("uri")
            if kind not in ("album", "playlist") or not uri or uri in seen_c or len(colls) >= max_colls:
                continue
            seen_c.add(uri)
            c = self._context_coll(kind, uri, items)
            if c:
                c["played"] = when
                colls.append(c)
        return {"colls": colls, "tracks": tracks}

    def _context_coll(self, kind, uri, items):
        """Scheda (nome, copertina…) dell'album o della playlist di un contesto."""
        if kind == "album":
            # di solito un brano ascoltato appartiene proprio a quell'album: nessuna richiesta
            for x in items:
                al = (x.get("track") or {}).get("album") or {}
                if al.get("uri") == uri:
                    return parse_coll(al, "album")
        hit = self._ctx_cache.get(uri)
        if hit and time.time() - hit[0] < CACHE_TTL:
            return dict(hit[1])
        cid = uri.rsplit(":", 1)[-1]
        try:
            if kind == "album":
                j = self.call("GET", f"albums/{cid}")
            else:
                j = self.call("GET", f"playlists/{cid}?" + urllib.parse.urlencode(
                    {"fields": "id,uri,name,images,owner(id,display_name)"}))
        except ApiError as e:
            if e.status == 429:
                raise
            return None  # playlist cancellata o non più accessibile: si salta
        c = parse_coll(j, kind)
        if c:
            self._ctx_cache[uri] = (time.time(), c)
        return dict(c) if c else None

    def all_items(self, page, max_pages=30):
        """Segue i link "next" della paginazione Spotify."""
        items = list((page or {}).get("items", []))
        nxt, n = (page or {}).get("next"), 0
        while nxt and n < max_pages:
            page = self.call("GET", nxt) or {}
            items += page.get("items", [])
            nxt, n = page.get("next"), n + 1
        return items

    def playlist_tracks(self, pid):
        try:
            j = self.call("GET", f"playlists/{pid}/items?limit=50") or {}
        except ApiError as e:
            if e.status == 403:
                raise ApiError(403, None, "Spotify non permette di vedere i brani delle playlist di altri utenti. "
                                          "Puoi comunque riprodurla con il pulsante ▶ in alto.") from None
            raise
        items = self.all_items(j, max_pages=60)  # fino a 3050 brani
        tracks = []
        for x in items:
            t = parse_track(x.get("item"))
            if t:
                t["added"] = (lambda v: "" if not v or v.startswith("1970") else v)(x.get("added_at"))
                tracks.append(t)
        # l'API non espone la data di creazione: si usa il primo brano aggiunto
        dates = sorted(x["added_at"] for x in items if x.get("added_at") and not x["added_at"].startswith("1970"))
        return {"tracks": tracks, "date": dates[0] if dates else ""}

    def album_tracks(self, coll):
        j = self.call("GET", f"albums/{coll['id']}") or {}
        big, _ = img_urls(j)
        items = self.all_items(j.get("tracks"))
        tracks = [t for t in (parse_track(x, big or coll["image"], coll["name"], coll["uri"]) for x in items) if t]
        artists = ", ".join(a.get("name", "") for a in j.get("artists") or [])
        return {"tracks": tracks, "date": j.get("release_date") or "", "type": release_type(j), "artists": artists}

    LIBRARY_BATCH = 40  # massimo di URI per chiamata a /me/library

    def in_library(self, uris):
        """URI -> True/False: se brani, album o playlist sono nella libreria (i brani: Preferiti)."""
        uris = [u for u in dict.fromkeys(uris) if u]
        out = {}
        for i in range(0, len(uris), self.LIBRARY_BATCH):
            part = uris[i:i + self.LIBRARY_BATCH]
            res = self.call("GET", "me/library/contains?" + urllib.parse.urlencode({"uris": ",".join(part)})) or []
            out.update(zip(part, res))
        return out

    def set_in_library(self, uri, on):
        """Aggiunge o toglie un elemento dalla libreria (per un brano: mi piace / non mi piace più)."""
        self.call("PUT" if on else "DELETE", "me/library?" + urllib.parse.urlencode({"uris": uri}))

    def me_id(self):
        if not getattr(self, "_me", None):
            self._me = (self.call("GET", "me") or {}).get("id")
        return self._me

    def artist(self, aid):
        """Album, singoli ed EP dell'artista, dal più recente."""
        j = self.call("GET", f"artists/{aid}/albums?include_groups=album,single&limit=10") or {}
        out, seen = [], set()
        for x in self.all_items(j, max_pages=10):
            c = parse_coll(x, "album")
            if not c:
                continue
            key = (c["name"].lower(), c["type"])
            if key in seen:
                continue
            seen.add(key)
            c["subtitle"] = " · ".join(v for v in (c["date"][:4], c["type"]) if v)
            c["added"] = c["date"]
            out.append(c)
        out.sort(key=lambda c: c["date"], reverse=True)
        try:
            image = img_urls(self.call("GET", f"artists/{aid}"))[1]
        except ApiError:
            image = None
        return {"releases": out, "image": image}

    def search(self, q):
        j = self.call("GET", "search?" + urllib.parse.urlencode({"q": q, "type": "track,album,artist,playlist", "limit": 10})) or {}
        items = lambda k: [x for x in (j.get(k) or {}).get("items", []) if x]  # noqa: E731
        return {"tracks": [t for t in map(parse_track, items("tracks")) if t],
                "artists": [c for c in (parse_coll(x, "artist") for x in items("artists")) if c],
                "albums": [c for c in (parse_coll(x, "album") for x in items("albums")) if c],
                # l'API blocca (403) i brani delle playlist di altri utenti: si mostrano solo le proprie
                "playlists": [c for c in (parse_coll(x, "playlist") for x in items("playlists")
                                          if (x.get("owner") or {}).get("id") == self.me_id()) if c]}


