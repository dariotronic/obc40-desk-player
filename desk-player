            self.add_row(view, t["name"], t["artists"], image=t["small"] if thumbs or self.cards else None,
                         number=None if thumbs else i + 1, current=t["uri"] == cur, uri=t["uri"],
                         action=(lambda i=i: on_play(i)) if on_play else None, buttons=buttons,
                         extra=fmt(t["duration"]))

