        if self.auth.missing_scopes():
            warn = label("Questa versione ha bisogno di nuovi permessi Spotify: tocca \"Esci dall'account\", "
                         "poi ricollegati dal PC come la prima volta.", "rsub", ellipsize=False, wrap=True)
            warn.set_margin_start(16); warn.set_margin_end(16); warn.set_margin_bottom(4)
