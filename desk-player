    def load(self, container, cache_key, fn, build):
        """Mostra uno spinner, carica in background e costruisce il contenuto."""
        token = self.token
        hit = self.cache.get(cache_key) if cache_key else None
        if hit and time.time() - hit[0] < CACHE_TTL:
            build(container, hit[1]); container.show_all()
            return
        spin = Gtk.Spinner(); spin.start(); spin.set_size_request(48, 48)
        box = Gtk.Box(valign=Gtk.Align.CENTER, halign=Gtk.Align.CENTER, vexpand=True)
        box.pack_start(spin, False, False, 0)
        container.pack_start(box, True, True, 0)

        def done(data):
            if token != self.token:
                return False
            if cache_key:
                self.cache[cache_key] = (time.time(), data)
            container.remove(box)
            build(container, data)
            container.show_all()
            return False

        def fail(e):
            if token != self.token:
                return False
            container.remove(box)
            err = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER, vexpand=True, spacing=8)
            err.pack_start(label(str(e) or "Errore", "text", 0.5, ellipsize=False, wrap=True), False, False, 0)
            again = Gtk.Button(label="Riprova"); again.get_style_context().add_class("chip")
            again.set_halign(Gtk.Align.CENTER)
            again.connect("clicked", lambda *_: self.render())
            err.pack_start(again, False, False, 0)
            container.pack_start(err, True, True, 0)
            container.show_all()
            return False
        self.bg(fn, done, fail)

